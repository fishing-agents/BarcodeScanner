    <string name="preferences_information_about_remote_api_title">Thông tin về các API</string>
    <string name="preferences_information_about_remote_api_foreword">Lời nói đầu</string>
    <string name="preferences_information_about_remote_api_what_is_an_api_title">API là gì?</string>
    <string name="preferences_information_about_remote_api_what_is_an_api_description">API là thư viện phần mềm được sử dụng để truy cập một dịch vụ. Trong trường hợp của ứng dụng này, API được sử dụng để truy cập các dịch vụ web. Dịch vụ web này lấy thông tin từ cơ sở dữ liệu.\nVí dụ, Open Food Facts là cơ sở dữ liệu về các sản phẩm thực phẩm. Open Food Facts cung cấp API để truy cập cơ sở dữ liệu của nó. Tôi sử dụng API này để hiển thị thông tin về các sản phẩm thực phẩm.</string>
    <string name="preferences_information_about_remote_api_barcode_types_concerned_title">Các loại mã vạch liên quan</string>
    <string name="preferences_information_about_remote_api_barcode_types_concerned_description">Chức năng tìm kiếm qua API chỉ được kích hoạt cho các mã vạch EAN 13, EAN 8, UPC A và UPC E.</string>
    <string name="preferences_information_about_remote_api_product_types_supported_title">Các loại sản phẩm được hỗ trợ</string>
    <string name="preferences_information_about_remote_api_product_types_supported_food">• Sản phẩm thực phẩm (với API Open Food Facts)</string>
    <string name="preferences_information_about_remote_api_product_types_supported_beauty">• Sản phẩm mỹ phẩm (với API Open Beauty Facts)</string>
    <string name="preferences_information_about_remote_api_product_types_supported_pet_food">• Sản phẩm thức ăn cho thú cưng (với API Open Pet Food Facts)</string>
    <string name="preferences_information_about_remote_api_product_types_supported_music">• CDs, Vinyls, … (với API MusicBrainz)</string>
    <string name="preferences_information_about_remote_api_product_types_supported_book">• Sách (với API Open Library)</string>
    <string name="preferences_information_about_remote_api_some_additional_information_title">Một số thông tin bổ sung</string>
    <string name="preferences_information_about_remote_api_some_additional_information_description_1">• Một số sản phẩm có thể không xuất hiện trong các cơ sở dữ liệu nhất định.</string>
    <string name="preferences_information_about_remote_api_some_additional_information_description_2">• Có thể có một số lỗi trong thông tin được API cung cấp.</string>
    <string name="preferences_information_about_remote_api_how_it_works">Cách hoạt động</string>
    <string name="preferences_information_about_remote_api_automatic_search_title">Tìm kiếm tự động</string>
    <string name="preferences_information_about_remote_api_automatic_search_description">Nếu tùy chọn \"%1$s\" được bật, khi bạn quét mã vạch sản phẩm, ứng dụng sẽ thực hiện tìm kiếm tự động thông qua API được chọn trong cài đặt. Nếu không có thông tin nào được tìm thấy qua API, bạn luôn có thể thực hiện tìm kiếm thủ công trên API khác sau khi quét.</string>
    <string name="preferences_information_about_remote_api_manual_search_title">Tìm kiếm thủ công</string>
    <string name="preferences_information_about_remote_api_manual_search_description">Nếu tùy chọn \"%1$s\" bị tắt, khi bạn quét mã vạch sản phẩm, ứng dụng sẽ không tự động lấy thông tin từ các máy chủ từ xa. Nhưng bạn luôn có thể tìm kiếm thông tin về sản phẩm được quét theo cách thủ công. Để làm điều này, sau khi quét sản phẩm, nhấp vào biểu tượng trong thanh menu. Sau đó, bạn có thể chọn một API để tìm kiếm.</string>
    <string name="preferences_information_about_remote_api_about_books_title">Sách</string>
    <string name="preferences_information_about_remote_api_about_books_description">Nếu sản phẩm bạn quét là một cuốn sách, bạn không cần chỉ định API để tìm kiếm thông tin. Mã vạch của một cuốn sách có thể được xác định bởi vì nó luôn bắt đầu với các chữ số \"978\". Tìm kiếm sẽ tự động được thực hiện trên Open Library.</string>
    <string name="preferences_remote_api_food_label">Open Food Facts (sản phẩm thực phẩm)</string>
    <string name="preferences_remote_api_pet_food_label">Open Pet Food Facts (sản phẩm thực phẩm cho thú cưng)</string>
    <string name="bdd_open_food_facts_description_label">Open Food Facts là cơ sở dữ liệu miễn phí về thực phẩm. Open Food Facts liệt kê các thành phần, chất gây dị ứng, thành phần dinh dưỡng và mọi thông tin có trên nhãn sản phẩm.</string>
