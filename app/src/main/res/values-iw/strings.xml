    <string name="barcode_code_39_description_label">קוד 39 הוא ברקוד שנמצא בשימוש בסימוני טקסטיל ותרופות בבתי מרקחת. הוא גם נמצא בשימוש במגזר הצבאי ותעשיית הרכב.</string>
    <string name="barcode_code_93_description_label">קוד 93 הוא ברקוד שנמצא בשימוש בצבא ותעשיות הרכב, כמו גם ע\"י Postes Canada כדי לקודד מידע של משלוחים מיוחדים.</string>
    <string name="barcode_code_128_description_label">קוד 128 הוא ברקוד שנמצא בשימוש בתעשיה לעתים קרובות. הוא נמצא בשימוש בתעשיית המשלוחים ועבור זיהוי מוצרים בשרשראות אספקה. הוא גם יכול לשמש בתעשיית הרכב או לסימון מוצרים בבתי מרקחת. קוד 128 נמצא בשימוש רחב ויכול גם לשמש למטרות אחרות.</string>
    <string name="barcode_itf_description_label">קוד ITF (Interleaved 2 of 5) הוא ברקוד שנמצא בשימוש בעיקר במשלוחי סחורות.</string>
    <string name="barcode_codabar_description_label">קוד Codabar הוא ברקוד המיועד לקריאה ע\"י מדפסות dot matrix. כיום, Codabar נמצא פחות בשימוש בגלל יתרונות של סוגי ברקוד אחרים, אך עדיין נמצא בשימוש ע\"י ארגונים מסויימים כגון ספריות.</string>
